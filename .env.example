# --- Database ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_platform
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_platform

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/uploads

# --- Embeddings ---
EMBEDDING_PROVIDER=local          # local | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- LLM ---
LLM_PROVIDER=openai               # openai | anthropic | ollama
LLM_MODEL=gpt-4o-mini
#GEMINI_API_KEY=
#GEMINI_API_KEY= 
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Retrieval ---
RETRIEVAL_TOP_K=8
HYBRID_ALPHA=0.5                  # weight between vector (1.0) and keyword (0.0)
RERANK_ENABLED=true
RERANK_TOP_N=4

# --- Security ---
API_AUTH_TOKEN=change-me-dev-token

# --- Vision (image description at ingestion) ---
vision_enabled: bool = True
ollama_vision_model: str = "qwen2.5vl:7b"
vision_max_tokens: int = 200

